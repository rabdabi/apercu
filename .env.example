# ── Aperçu environment ───────────────────────────────────────────────────────
# Copy to `.env` for local development:  cp .env.example .env
# NEVER commit a real .env — it is gitignored. Do not put real credentials here.

# Runtime environment. One of: development | production
NODE_ENV=development

# Public canonical origin (used for canonical URLs, Open Graph, sitemap, RSS).
# Exposed to the client, so it must not contain secrets.
PUBLIC_SITE_URL=http://localhost:4321

# Port the server listens on.
#   - Local development: optional; defaults to 4321.
#   - Production (Infomaniak): injected by the platform. DO NOT hard-code it.
# PORT=4321

# MariaDB / MySQL connection string (Drizzle + mysql2).
# When UNSET, form endpoints run in an explicit non-persistent development mode
# (they respond clearly with persisted:false instead of crashing). Set this to
# enable real persistence.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=
