---
import { t } from '@/lib/i18n';
import { formatDateShort } from '@/lib/format';

const now = new Date();
const links = [
  { href: '/perspectives', label: t('nav.stories') },
  { href: '/episodes', label: 'Episoden' },
  { href: '/index', label: t('nav.index') },
  { href: '/about', label: t('nav.about') },
];
const path = Astro.url.pathname;
---

<header class="nav">
  <div class="nav__inner grid-editorial">
    <a href="/" class="nav__brand" aria-label="Aperçu — Startseite">
      <span class="nav__wordmark">Aperçu</span>
      <span class="mono nav__meta">FILE / 0001 · {formatDateShort(now)}</span>
    </a>

    <nav class="nav__links" aria-label="Hauptnavigation">
      <ul>
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class="nav__link mono"
                aria-current={path.startsWith(l.href) ? 'page' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      type="button"
      class="nav__toggle mono"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span data-menu-label>{t('nav.menu')}</span>
    </button>
  </div>

  <!-- Mobile menu: a designed full-screen editorial panel, not a generic overlay -->
  <div class="mobile-menu" id="mobile-menu" data-menu-panel hidden>
    <nav aria-label="Hauptnavigation (mobil)">
      <ol class="mobile-menu__list">
        {
          links.map((l, i) => (
            <li>
              <a href={l.href} class="mobile-menu__link">
                <span class="mono mobile-menu__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="mobile-menu__word">{l.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
    <p class="mono mobile-menu__foot">APERÇU — GESCHICHTEN FÜR DEN GENAUEREN BLICK</p>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in oklab, var(--c-ground) 82%, transparent);
    backdrop-filter: saturate(120%) blur(8px);
    border-bottom: 1px solid var(--c-line);
  }
  .nav__inner {
    align-items: center;
    padding-block: 0.85rem;
  }
  .nav__brand {
    grid-column: 1 / 7;
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
  }
  .nav__wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }
  .nav__meta {
    display: none;
  }
  @media (min-width: 48rem) {
    .nav__meta {
      display: inline;
    }
  }
  .nav__links {
    grid-column: 7 / -1;
    display: none;
  }
  @media (min-width: 48rem) {
    .nav__links {
      display: block;
    }
  }
  .nav__links ul {
    display: flex;
    justify-content: flex-end;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav__link {
    position: relative;
    padding-block: 0.25rem;
    color: var(--c-ink-dim);
    transition: color 0.2s var(--ease-out);
  }
  .nav__link:hover,
  .nav__link[aria-current='page'] {
    color: var(--c-ink);
  }
  .nav__link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.35rem;
    width: 100%;
    height: 2px;
    background: var(--c-accent);
  }
  .nav__toggle {
    grid-column: 11 / -1;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--c-line-strong);
    background: transparent;
    color: var(--c-ink);
    cursor: pointer;
  }
  @media (min-width: 48rem) {
    .nav__toggle {
      display: none;
    }
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 39;
    background: var(--c-ground);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--gutter);
  }
  .mobile-menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--c-line);
  }
  .mobile-menu__link {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--c-line);
  }
  .mobile-menu__num {
    color: var(--c-accent);
  }
  .mobile-menu__word {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 12vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .mobile-menu__foot {
    margin-top: 2rem;
  }
</style>

<script>
  // Accessible mobile menu: toggle, Escape to close, focus management,
  // and scroll lock. Progressive — links work with JS disabled (panel is
  // only shown via the toggle, which is itself hidden on desktop).
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  if (toggle && panel && label) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Schliessen' : 'Menü';
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) {
        panel.querySelector<HTMLAnchorElement>('a')?.focus();
      } else {
        toggle.focus();
      }
    };

    toggle.addEventListener('click', () => setOpen(panel.hidden));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) setOpen(false);
    });
    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  }
</script>
