---
/**
 * The recurring Aperçu line-motif — thin overlapping circles reading as an
 * aperture. A quiet graphical signature reused across cinematic chapters and
 * section breaks (see docs/visual-language.md §09/§11). Inherits currentColor.
 */
export interface Props {
  size?: number;
  class?: string;
}
const { size = 64, class: className = '' } = Astro.props;
---

<svg
  class:list={['motif', className]}
  width={size}
  height={size}
  viewBox="0 0 64 40"
  fill="none"
  stroke="currentColor"
  stroke-width="1"
  aria-hidden="true"
>
  <circle cx="26" cy="20" r="15"></circle>
  <circle cx="38" cy="20" r="15"></circle>
  <circle cx="32" cy="20" r="3.5" fill="currentColor" stroke="none"></circle>
</svg>

<style>
  .motif {
    display: block;
    opacity: 0.7;
  }
</style>
