---
import PlaceholderVisual from './PlaceholderVisual.astro';

export interface Props {
  variant?: 'grid' | 'orbit' | 'bars' | 'wave';
  reverse?: boolean;
  caption?: string;
  src?: string;
  alt?: string;
}
const { variant = 'bars', reverse = false, caption, src, alt } = Astro.props;
---

<section class:list={['bleed-wide split', { 'split--reverse': reverse }]} data-reveal>
  <div class="split__text">
    <slot />
  </div>
  <figure class="split__media">
    {
      src ? (
        <img src={src} alt={alt ?? ''} loading="lazy" decoding="async" />
      ) : (
        <PlaceholderVisual variant={variant} label={caption} />
      )
    }
  </figure>
</section>

<style>
  .split {
    margin-block: clamp(3rem, 7vw, 5rem);
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 55rem) {
    .split {
      grid-template-columns: 1fr 1fr;
      gap: clamp(2rem, 5vw, 4rem);
    }
    .split--reverse .split__text {
      order: 2;
    }
  }
  .split__text :global(> * + *) {
    margin-top: 1.1rem;
  }
  .split__media {
    margin: 0;
  }
  .split__media img {
    width: 100%;
    border: 1px solid var(--c-line);
  }
</style>
