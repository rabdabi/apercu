---
/**
 * Video-as-illustration. Behaves like an image, not a player: muted, looping,
 * autoplay only while visible, poster first, no chrome. Under reduced-motion it
 * shows the poster (or a static generated frame) and never animates.
 *
 * With no `src` (we have no real footage yet), it renders a generated cinematic
 * canvas — a slow dark drift — so the film feeling is real now and a real
 * `.webm` drops in later by passing `src`.
 */
export interface Props {
  src?: string;
  poster?: string;
  fill?: boolean; // absolutely fill a positioned parent (for chapter backgrounds)
  objectPosition?: string;
  tint?: 'ink' | 'red';
  class?: string;
}
const { src, poster, fill = false, objectPosition = 'center', tint = 'ink', class: className = '' } =
  Astro.props;
---

{
  src ? (
    <video
      class:list={['ambient', { 'ambient--fill': fill }, className]}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={poster}
      style={`object-position:${objectPosition}`}
      data-ambient-video
      aria-hidden="true"
    >
      <source src={src} type="video/webm" />
    </video>
  ) : (
    <canvas
      class:list={['ambient', { 'ambient--fill': fill }, className]}
      data-ambient-canvas
      data-tint={tint}
      aria-hidden="true"
    />
  )
}

<style>
  .ambient {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--c-ink-ground);
  }
  .ambient--fill {
    position: absolute;
    inset: 0;
  }
</style>

<script>
  // Autoplay real clips only while visible; pause offscreen; honour reduced motion.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('[data-ambient-video]'));
  if (videos.length) {
    if (reduce) {
      videos.forEach((v) => {
        v.autoplay = false;
        v.removeAttribute('autoplay');
        v.pause();
      });
    } else if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting) v.play().catch(() => {});
            else v.pause();
          }
        },
        { threshold: 0.1 },
      );
      videos.forEach((v) => io.observe(v));
    }
  }

  // Generated cinematic canvas for the no-footage case.
  const canvases = Array.from(document.querySelectorAll<HTMLCanvasElement>('[data-ambient-canvas]'));
  for (const canvas of canvases) {
    const ctx = canvas.getContext('2d');
    if (!ctx) continue;
    const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
    const warm = canvas.dataset.tint === 'red';

    const resize = () => {
      const r = canvas.getBoundingClientRect();
      canvas.width = Math.max(1, Math.floor(r.width * dpr));
      canvas.height = Math.max(1, Math.floor(r.height * dpr));
    };
    resize();
    window.addEventListener('resize', resize, { passive: true });

    const blobs = Array.from({ length: 5 }, (_, i) => ({
      x: Math.random(),
      y: Math.random(),
      r: 0.25 + Math.random() * 0.3,
      sx: (Math.random() - 0.5) * 0.00006,
      sy: (Math.random() - 0.5) * 0.00006,
      p: i,
    }));

    const draw = (t: number) => {
      const w = canvas.width;
      const h = canvas.height;
      ctx.fillStyle = '#17140f';
      ctx.fillRect(0, 0, w, h);
      for (const b of blobs) {
        const cx = (b.x + Math.sin(t * 0.0002 + b.p) * 0.05) * w;
        const cy = (b.y + Math.cos(t * 0.00017 + b.p) * 0.05) * h;
        const rad = b.r * Math.max(w, h);
        const g = ctx.createRadialGradient(cx, cy, 0, cx, cy, rad);
        const core = warm ? '54,26,18' : '42,36,28';
        g.addColorStop(0, `rgba(${core},0.55)`);
        g.addColorStop(1, 'rgba(23,20,15,0)');
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(cx, cy, rad, 0, Math.PI * 2);
        ctx.fill();
      }
    };

    if (reduce) {
      draw(0);
      continue;
    }

    let raf = 0;
    let last = 0;
    let visible = false;
    const loop = (t: number) => {
      if (t - last > 66) {
        draw(t);
        last = t;
      } // ~15fps
      raf = requestAnimationFrame(loop);
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting && !visible) {
            visible = true;
            raf = requestAnimationFrame(loop);
          } else if (!e.isIntersecting && visible) {
            visible = false;
            cancelAnimationFrame(raf);
          }
        }
      },
      { threshold: 0 },
    );
    io.observe(canvas);
    draw(0);
  }
</script>
