---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CinematicChapter from '@/components/story/CinematicChapter.astro';
import FilmPlayer from '@/components/media/FilmPlayer.astro';
import EmilFigure from '@/components/story/EmilFigure.astro';
import MetaRule from '@/components/core/MetaRule.astro';
import Motif from '@/components/story/Motif.astro';
import { getFeaturedStory } from '@/lib/stories';
import { isProduction } from '@/lib/env';
import { formatDate, pad } from '@/lib/format';

export const prerender = true;

const featured = await getFeaturedStory();
const episodes = (
  await getCollection('episodes', ({ data }) => (isProduction ? data.draft === false : true))
).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const slugOf = (id: string) => id.replace(/\/(index|episode)$/, '');
const filmCount = episodes.length + (featured ? 1 : 0);
---

<BaseLayout
  title="Aperçu"
  description="Aperçu erzählt in kurzen animierten Filmen von Macht, Geld und Aufmerksamkeit — mit einer wiederkehrenden Figur, Emil. Die Recherchen dazu leben in den Perspektiven."
>
  <!-- ── Hero: what's going on + the animated character ─────────────────── -->
  <section class="hero" aria-label="Aperçu">
    <div class="grid-editorial hero__grid">
      <MetaRule label="APERÇU — BEWEGTE ESSAYS" value={formatDate(new Date())} />

      <div class="hero__lead">
        <h1 class="wordmark" aria-label="Aperçu">
          <span class="wordmark__row">AP</span>
          <span class="wordmark__row">ER</span>
          <span class="wordmark__row wordmark__row--accent">ÇU</span>
        </h1>
        <p class="hero__intro">
          Kurze <em>animierte Filme</em> über Macht, Geld und Aufmerksamkeit — erzählt von
          einer wiederkehrenden Figur.
        </p>
      </div>

      <figure class="hero__emil">
        <EmilFigure pose="idle" sway size={300} />
        <figcaption class="mono hero__emil-cap">EMIL · PROTAGONIST · PLATZHALTER</figcaption>
      </figure>
    </div>

    <a href="#worum-es-geht" class="hero__scroll mono">
      <span>WEITER</span><span class="hero__arrow" aria-hidden="true">↓</span>
    </a>
  </section>

  <!-- ── The premise, as a film moment ──────────────────────────────────── -->
  <CinematicChapter
    id="worum-es-geht"
    kicker="Worum es geht"
    title="Emil steht am Rand der Macht — und sieht, was niemand sehen soll."
    lead="Eine Welt, in der Reichtum nicht die Kleider ändert, sondern das Bild selbst."
    variant="film"
  >
    Arme Welt: rohe Tinte, leerer Raum, zwei Farben. Reiche Welt: Gold, Ornament,
    Symmetrie. Dieselbe Figur, dasselbe Universum — nur anders gezeichnet.
  </CinematicChapter>

  <!-- ── The films (the character's animated videos) ────────────────────── -->
  <section class="films grid-editorial" aria-labelledby="films-title">
    <MetaRule label="DIE FILME" value={`${pad(filmCount, 3)} · IN PRODUKTION`} />
    <h2 id="films-title" class="films__title">Die Filme</h2>

    {
      featured && (
        <div class="film-feature col-wide">
          <FilmPlayer title={featured.data.title} duration="02:31" />
          <div class="film-feature__meta">
            <p class="mono film-feature__kick">FILM / 001</p>
            <h3 class="film-feature__h">{featured.data.title}</h3>
            {featured.data.subtitle && <p class="film-feature__sub">{featured.data.subtitle}</p>}
            <a class="mono film-feature__link" href={`/perspectives/${slugOf(featured.id)}`}>
              → Zur Recherche (Text)
            </a>
          </div>
        </div>
      )
    }

    {
      episodes.length > 0 ? (
        <ol class="films__list col-wide">
          {episodes.map((e, i) => (
            <li class="films__item">
              <a href={`/episodes/${slugOf(e.id)}`} class="films__row">
                <span class="mono films__num">{pad(i + 2)}</span>
                <span class="films__name">{e.data.title}</span>
                <span class="mono films__date">{formatDate(e.data.publishedAt)}</span>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="films__note mono col-wide">
          Weitere Filme sind in Produktion — handgezeichnet in Moho, mit Emil als
          durchgehender Figur.
        </p>
      )
    }
  </section>

  <!-- ── Pointer to the journalism track ────────────────────────────────── -->
  <section class="reading grid-editorial" aria-labelledby="reading-title">
    <div class="reading__motif" aria-hidden="true"><Motif size={80} /></div>
    <h2 id="reading-title" class="reading__title">Lieber lesen?</h2>
    <p class="reading__body">
      Die journalistische Recherche hinter jedem Film — Zahlen, Quellen, Belege — lebt in
      den <strong>Perspektiven</strong>.
    </p>
    <a href="/perspectives" class="mono reading__link">→ Perspektiven</a>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding-block: clamp(2rem, 6vh, 4rem) clamp(2rem, 5vh, 4rem);
    min-height: min(84vh, 56rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .hero__grid {
    row-gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
    flex: 1;
  }
  .hero__lead {
    grid-column: 1 / -1;
  }
  @media (min-width: 55rem) {
    .hero__lead {
      grid-column: 1 / 8;
    }
  }
  .wordmark {
    font-size: clamp(3.5rem, 14vw, 11rem);
    line-height: 0.82;
    letter-spacing: -0.03em;
    margin: 0;
    display: grid;
    color: var(--c-ink);
  }
  .wordmark__row--accent {
    color: var(--c-accent);
  }
  .hero__intro {
    margin-top: 1.4rem;
    max-width: 30ch;
    font-family: var(--font-body);
    font-size: clamp(1.2rem, 1rem + 1vw, 1.9rem);
    line-height: 1.35;
    color: var(--c-ink-dim);
  }
  .hero__intro em {
    font-style: italic;
    color: var(--c-rubric);
  }
  .hero__emil {
    grid-column: 1 / -1;
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 0.8rem;
  }
  @media (min-width: 55rem) {
    .hero__emil {
      grid-column: 9 / -1;
      justify-items: end;
    }
  }
  .hero__emil-cap {
    color: var(--c-ink-faint);
  }
  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding-inline: var(--gutter);
    max-width: 1680px;
    margin-inline: auto;
    width: 100%;
    color: var(--c-ink-dim);
  }
  .hero__arrow {
    animation: nudge 1.8s var(--ease-out) infinite;
  }
  @keyframes nudge {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__arrow {
      animation: none;
    }
  }

  /* Films */
  .films {
    padding-block: clamp(3rem, 8vw, 6rem);
    border-top: 1px solid var(--c-line);
    row-gap: 1.5rem;
  }
  .films__title {
    grid-column: 1 / -1;
    font-size: clamp(2.4rem, 1.5rem + 5vw, 6rem);
    line-height: 0.95;
    color: var(--c-ink);
  }
  .film-feature {
    display: grid;
    gap: 1.5rem;
    margin-top: 1rem;
  }
  @media (min-width: 60rem) {
    .film-feature {
      grid-template-columns: 1.6fr 1fr;
      align-items: end;
    }
  }
  .film-feature__kick {
    color: var(--c-accent);
  }
  .film-feature__h {
    font-size: clamp(1.8rem, 1.2rem + 3vw, 3.4rem);
    line-height: 1;
    margin: 0.4rem 0 0.6rem;
  }
  .film-feature__sub {
    color: var(--c-ink-dim);
    max-width: 40ch;
    margin-bottom: 1rem;
  }
  .film-feature__link {
    color: var(--c-rubric);
  }
  .films__note {
    color: var(--c-ink-faint);
    max-width: 52ch;
    padding-top: 1rem;
    line-height: 1.8;
  }
  .films__list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    border-top: 1px solid var(--c-line);
  }
  .films__row {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    gap: 1.2rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--c-line);
    align-items: baseline;
  }
  .films__num {
    color: var(--c-ink-faint);
  }
  .films__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.3rem, 1rem + 1.6vw, 2.2rem);
    letter-spacing: -0.02em;
  }
  .films__row:hover .films__name {
    color: var(--c-rubric);
  }
  .films__date {
    color: var(--c-ink-faint);
  }

  /* Reading pointer */
  .reading {
    padding-block: clamp(3rem, 8vw, 6rem);
    border-top: 1px solid var(--c-line);
    row-gap: 1rem;
  }
  .reading__motif {
    grid-column: 1 / -1;
    color: var(--c-line-strong);
  }
  .reading__title {
    grid-column: 1 / -1;
    font-size: clamp(1.8rem, 1.2rem + 3vw, 3.4rem);
    color: var(--c-ink);
  }
  .reading__body {
    grid-column: 1 / -1;
    max-width: 46ch;
    color: var(--c-ink-dim);
    font-size: 1.1rem;
  }
  @media (min-width: 60rem) {
    .reading__body {
      grid-column: 1 / 8;
    }
  }
  .reading__link {
    grid-column: 1 / -1;
    color: var(--c-rubric);
  }
</style>
